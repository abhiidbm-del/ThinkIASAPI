      "name": "01 Auth",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/api/app/auth/send-otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('OTP sent', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json().data || {};",
                  "if (data.challengeId) pm.collectionVariables.set('challengeId', data.challengeId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend OTP",
