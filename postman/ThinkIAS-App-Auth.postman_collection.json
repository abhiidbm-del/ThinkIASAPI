{
  "info": {
    "name": "ThinkIAS App Auth — UI flow / test OTP 1234",
    "description": "Email-first registration matching ThinkIAS-APP-UI PDFs. No email is sent. Test OTP is 1234. Run requests in order. The first request generates a unique test email unless an environment email is set. App tokens expire after 24h and are revoked on logout or app password reset.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "Student123!"
    },
    {
      "key": "newPassword",
      "value": "Changed123!"
    },
    {
      "key": "otp",
      "value": "1234"
    },
    {
      "key": "registrationChallengeId",
      "value": ""
    },
    {
      "key": "verificationToken",
      "value": ""
    },
    {
      "key": "resetChallengeId",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 — Sign up: Send email code",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/app/auth/send-otp",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('email')) pm.collectionVariables.set('email', 'app.student.'+Date.now()+'@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { const data=pm.response.json().data; pm.collectionVariables.set('registrationChallengeId', data.challengeId); }"
            ]
          }
        }
      ]
    },
    {
      "name": "02 — Resend code / countdown",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/app/auth/resend-otp",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"challengeId\": \"{{registrationChallengeId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Before the UI 120-second timer finishes, 429 plus retryAfterSeconds is expected. After the timer it returns 200. Both are valid in this collection."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Resend or countdown', function(){pm.expect(pm.response.code).to.be.oneOf([200,429]);});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 — Wrong OTP is rejected",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/app/auth/verify-email",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"challengeId\": \"{{registrationChallengeId}}\",\n  \"otp\": \"9999\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 — Verify email: OTP 1234",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/app/auth/verify-email",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"challengeId\": \"{{registrationChallengeId}}\",\n  \"otp\": \"{{otp}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { const data=pm.response.json().data; pm.collectionVariables.set('verificationToken', data.verificationToken); }"
            ]
          }
        }
      ]
    },
    {
      "name": "05 — Submit registration form",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/app/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"verificationToken\": \"{{verificationToken}}\",\n  \"fullName\": \"App Test Student\",\n  \"phone\": \"9876543210\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { const data=pm.response.json().data; pm.collectionVariables.set('token', data.token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "06 — Current student",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/app/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 — Confirm Logout",
      "request": {
